<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

	<Type Name="VectorBase&lt;*&gt;">
		<DisplayString Condition="m_ptrEnd == m_ptrBegin">[empty] {{}}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 1">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 2">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 3">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)}, {*(m_ptrBegin+2)} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 4">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)}, {*(m_ptrBegin+2)}, {*(m_ptrBegin+3)} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 5">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)}, {*(m_ptrBegin+2)}, {*(m_ptrBegin+3)}, {*(m_ptrBegin+4)} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 6">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)}, {*(m_ptrBegin+2)}, {*(m_ptrBegin+3)}, {*(m_ptrBegin+4)}, {*(m_ptrBegin+5)} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin &gt; 6">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)}, {*(m_ptrBegin+2)}, {*(m_ptrBegin+3)}, {*(m_ptrBegin+4)}, {*(m_ptrBegin+5)}, ... }}</DisplayString>
		<Expand>
			<Item Name="[size]">m_ptrEnd - m_ptrBegin</Item>
			<Item Name="[capacity]">m_capacityAllocator.m_first - m_ptrBegin</Item>
			<ArrayItems>
				<Size>m_ptrEnd - m_ptrBegin</Size>
				<ValuePointer>m_ptrBegin</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="StackVector&lt;*&gt;">
		<DisplayString Condition="m_ptrEnd == m_ptrBegin">[empty] {{}}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 1">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 2">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 3">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)}, {*(m_ptrBegin+2)} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 4">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)}, {*(m_ptrBegin+2)}, {*(m_ptrBegin+3)} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 5">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)}, {*(m_ptrBegin+2)}, {*(m_ptrBegin+3)}, {*(m_ptrBegin+4)} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin == 6">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)}, {*(m_ptrBegin+2)}, {*(m_ptrBegin+3)}, {*(m_ptrBegin+4)}, {*(m_ptrBegin+5)} }}</DisplayString>
		<DisplayString Condition="m_ptrEnd - m_ptrBegin &gt; 6">[{m_ptrEnd - m_ptrBegin}] {{ {*m_ptrBegin}, {*(m_ptrBegin+1)}, {*(m_ptrBegin+2)}, {*(m_ptrBegin+3)}, {*(m_ptrBegin+4)}, {*(m_ptrBegin+5)}, ... }}</DisplayString>
		<Expand>
			<Item Name="[size]">m_ptrEnd - m_ptrBegin</Item>
			<Item Name="[capacity]">m_ptrCapacity - m_ptrBegin</Item>
			<ArrayItems>
				<Size>m_ptrEnd - m_ptrBegin</Size>
				<ValuePointer>m_ptrBegin</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="BasicString&lt;*&gt;">
		<DisplayString Condition="!!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">"{m_layout.heap.m_begin,sb}"</DisplayString>
		<DisplayString Condition="!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">"{m_layout.sso.mData,sb}"</DisplayString>
		<Expand>
			<Item Name="[length]"   Condition="!!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">m_layout.heap.m_size</Item>
			<Item Name="[capacity]" Condition="!!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">(m_layout.heap.m_capacity &amp; ~kHeapMask)</Item>
			<Item Name="[value]"    Condition="!!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">m_layout.heap.m_begin,sb</Item>

			<Item Name="[length]"   Condition="!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">(SSOLayout::SSO_CAPACITY - m_layout.sso.m_remainingSizeField.m_remainingSize)</Item>
			<Item Name="[capacity]" Condition="!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">SSOLayout::SSO_CAPACITY</Item>
			<Item Name="[value]"    Condition="!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">m_layout.sso.m_data,sb</Item>

			<Item Name="[uses heap]">!!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)</Item>
		</Expand>
	</Type>

	<Type Name="BasicString&lt;wchar_t,*&gt;">
		<DisplayString Condition="!!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">"{m_layout.heap.m_begin,sb}"</DisplayString>
		<DisplayString Condition="!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">"{m_layout.sso.m_data,sb}"</DisplayString>
		<Expand>
			<Item Name="[length]"   Condition="!!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">m_layout.heap.m_size</Item>
			<Item Name="[capacity]" Condition="!!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">(m_layout.heap.m_capacity &amp; ~kHeapMask)</Item>
			<Item Name="[value]"    Condition="!!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">m_layout.heap.m_begin,sb</Item>

			<Item Name="[length]"   Condition="!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">(SSOLayout::SSO_CAPACITY - m_layout.sso.m_remainingSizeField.m_remainingSize)</Item>
			<Item Name="[capacity]" Condition="!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">SSOLayout::SSO_CAPACITY</Item>
			<Item Name="[value]"    Condition="!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)">m_layout.sso.m_data,sb</Item>

			<Item Name="[uses heap]">!!(m_layout.sso.m_remainingSizeField.m_remainingSize &amp; kSSOMask)</Item>
		</Expand>
	</Type>

	<Type Name="BasicStringView&lt;*&gt;">
		<DisplayString>{m_begin,[m_count]}</DisplayString>
		<StringView>m_begin,[m_count]</StringView>
	</Type>
</AutoVisualizer>